<Window
    x:Class="YYBToolbox.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:YYBToolbox.WinUI.Pages"
    Title="安卓引擎工具箱 · YYB Toolbox">

    <Grid Background="#0f1218">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#11151c" Padding="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Grid.Column="0">
                <TextBlock Text="安卓引擎工具箱" FontSize="18" FontWeight="SemiBold" Foreground="#e6e9ef" VerticalAlignment="Center" />
                <Border Background="#1d232d" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionBadge" FontSize="12" Foreground="#98a2b3" />
                </Border>
            </StackPanel>
            <TextBlock x:Name="ConnState" Grid.Column="1" Foreground="#98a2b3" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />
            <Button x:Name="ConnectButton" Grid.Column="2" Click="OnConnectClicked" Content="连接引擎" />
        </Grid>

        <NavigationView x:Name="NavView" Grid.Row="1" IsPaneOpen="True" PaneDisplayMode="Left"
                        SelectionChanged="OnNavSelectionChanged" IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="首页" Tag="home" />
                <NavigationViewItem Content="应用管理" Tag="apps" />
                <NavigationViewItem Content="文件" Tag="files" />
                <NavigationViewItem Content="终端" Tag="shell" />
                <NavigationViewItem Content="日志" Tag="logcat" />
                <NavigationViewItem Content="截图 / 录屏" Tag="shot" />
                <NavigationViewItem Content="系统设置" Tag="settings" />
                <NavigationViewItem Content="诊断" Tag="diag" />
                <NavigationViewItem Content="MicroG" Tag="microg" />
                <NavigationViewItem Content="Root / Magisk" Tag="root" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <TextBlock Grid.Row="2" x:Name="StatusBar" Foreground="#98a2b3" FontSize="12" Padding="16,8" />
    </Grid>
</Window>
