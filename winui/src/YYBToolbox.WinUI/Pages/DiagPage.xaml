<UserControl
    x:Class="YYBToolbox.WinUI.Pages.DiagPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Click="OnRunClicked" Content="运行诊断" />

        <ScrollViewer Grid.Row="1">
            <TextBox x:Name="DiagBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     FontFamily="Consolas" Background="#11151c" Foreground="#e6e9ef" />
        </ScrollViewer>
    </Grid>
</UserControl>
