<UserControl
    x:Class="YYBToolbox.WinUI.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandBox" PlaceholderText="输入 shell 命令，例如 pm list packages" KeyDown="OnCommandKeyDown" />
            <Button Grid.Column="1" Click="OnRunClicked" Content="执行" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                      FontFamily="Consolas" Background="#11151c" Foreground="#e6e9ef" />
        </ScrollViewer>
    </Grid>
</UserControl>
